# Copy this file to `.env` (never commit `.env`) and edit the values.

NODE_ENV=development
PORT=4000

# PostgreSQL connection strings. Create the databases first, e.g.:
#   createdb haqlink && createdb haqlink_test
DATABASE_URL=postgres://haqlink:change-me@localhost:5432/haqlink
# Used only by `npm test` (integration tests wipe and re-seed this database — never point it at real data).
# The database name must end in `_test`.
DATABASE_URL_TEST=postgres://haqlink:change-me@localhost:5432/haqlink_test
# Set to true when the database requires TLS (most managed Postgres services do).
DATABASE_SSL=false
# Optional: a more privileged role used only by `npm run retention:purge` when the app runs as a restricted role.
# DATABASE_ADMIN_URL=

# REQUIRED. A long random string used to sign session tokens. Generate one with:  openssl rand -hex 48
JWT_SECRET=
SESSION_DAYS=7

# The browser origin of the web app (used for CORS and the cross-site request check).
CLIENT_ORIGIN=http://localhost:5173
# Set to 1 when running behind exactly one reverse proxy, so rate limiting sees real client IPs.
# TRUST_PROXY=1

BCRYPT_ROUNDS=12

# Private folder for lawyers' verification documents. Never serve it statically.
UPLOAD_DIR=storage/credentials
MAX_UPLOAD_MB=5

# Business rule: when true, a lawyer profile can only be published after an administrator verifies it.
# When false (default), unverified profiles may appear in the directory but are clearly labelled "Not verified".
REQUIRE_VERIFICATION_TO_PUBLISH=false

# Appointment booking rules.
APPOINTMENT_MIN_NOTICE_HOURS=12
APPOINTMENT_HORIZON_DAYS=30

# Days a deleted account is kept (anonymised) before `npm run retention:purge` removes it for good.
# This is a development default, not legal advice: set it with qualified advice for your jurisdiction.
DELETED_ACCOUNT_RETENTION_DAYS=30

# Optional: serve the built web app from this API process (after `npm run build`), e.g. ../client/dist
# CLIENT_DIST=../client/dist

# Only for loading demo data into a production-mode database (you almost certainly should not).
# ALLOW_DEMO_SEED=false
